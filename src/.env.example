# Copy thành .env rồi điền key thật. KHÔNG commit file .env.
# File .env được đọc khi chạy từ thư mục src/ (uvicorn main:app).

# --- vector store ---
QDRANT_URL=http://localhost:6333
COLLECTION=rag_docs

# --- model ---
# Tier 1: HyDE paraphrase (rẻ). Tier 2: trả lời (mạnh). Spec = "provider:model"
LLM_LV1=ollama:qwen3:1.7b
LLM_LV1_API_KEY=
LLM_LV2=ollama:qwen3:1.7b
LLM_LV2_API_KEY=
EMBED_MODEL=ollama:RizwanMalik/qwen3-vl-embedding-2b:q4_0-q8_0
EMBED_API_KEY=
RERANKER_MODEL=Qwen/Qwen3-Reranker-0.6B

# --- pipeline ---
OUTPUT_DIR=output
MAX_TABLE_ROWS=50
N_PARAPHRASES=3
HYDE_K=10
FUSED_K=20
RRF_K=60
TOP_PARENTS=3
MAX_CHILD_PER_PARENT=10
TOP_N=5

# --- tracing (tuỳ chọn) ---
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=super_rag
OPENROUTER_API_KEY=
